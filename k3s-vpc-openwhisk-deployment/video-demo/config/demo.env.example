# Copy thành demo.env và chỉ dùng giá trị private VPC.
VPC_CIDR=192.168.1.0/24
SERVER_NAME=c1-server
SERVER_PRIVATE_IP=192.168.1.5
AGENT1_NAME=c1-agent1
AGENT1_PRIVATE_IP=192.168.1.102
AGENT2_NAME=c1-agent2
AGENT2_PRIVATE_IP=192.168.1.46
AGENT3_NAME=c1-agent3
AGENT3_PRIVATE_IP=192.168.1.242
API_HOST=192.168.1.5
VPC_INTERFACE=<vpc-interface>
INVOKER_REPLICAS=2
RELEASE=owdev
NAMESPACE=openwhisk

# Tuỳ chọn: Prometheus/Grafana hiện có trên VPS.
PROMETHEUS_URL=
GRAFANA_URL=
