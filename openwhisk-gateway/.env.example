# Copy to .env, set values for clusters you have deployed, then chmod 600 .env.
# Use the Base64 guest-auth value printed in the matching gateway-line-cX.txt.
ACTIVE=c1
GATEWAY_BIND_HOST=100.x.x.x
GATEWAY_PORT=8080
CLUSTER_C1_URL=https://100.x.x.x:31001
CLUSTER_C1_AUTH_B64=
CLUSTER_C2_URL=https://100.x.x.x:31001
CLUSTER_C2_AUTH_B64=
CLUSTER_C3_URL=https://100.x.x.x:31001
CLUSTER_C3_AUTH_B64=
